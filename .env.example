VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key

# Public client keys may be used in the browser when database RLS is enabled.
# Never put a Supabase service-role key or a VAPID private key in VITE_* variables.
